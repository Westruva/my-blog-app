{
	"name": "my-blog-app",
	"private": true,
	"version": "1.0.0",
	"workspaces": [
		"backend",
		"web",
		"admin"
	],
	"scripts": {
		"dev": "concurrently \"npm run dev --workspace backend\" \"npm run dev --workspace web\" \"npm run dev --workspace admin\"",
		"build": "npm run build --workspace web && npm run build --workspace admin",
		"start": "npm run start --workspace backend",
		"db:generate": "npm run db:generate --workspace backend",
		"db:migrate": "npm run db:migrate --workspace backend",
		"db:seed": "npm run db:seed --workspace backend",
		"test": "npm test --workspace backend",
		"audit": "npm audit --audit-level=high"
	},
	"devDependencies": {
		"concurrently": "^9.1.2"
	}
}
