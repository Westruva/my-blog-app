{
	"name": "blog-backend",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/server.js",
		"prestart": "prisma generate && prisma migrate deploy",
		"start": "node src/server.js",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:seed": "prisma db seed",
		"test": "DATABASE_URL=postgresql://test:test@localhost:5432/test JWT_SECRET=test-secret node --test test/auth.test.js",
		"test:integration": "RUN_INTEGRATION_TESTS=1 node --test test/integration.test.js"
	},
	"dependencies": {
		"@prisma/client": "^6.16.2",
		"bcryptjs": "^3.0.2",
		"cors": "^2.8.5",
		"dotenv": "^17.2.2",
		"express": "^5.1.0",
		"express-rate-limit": "^7.5.0",
		"helmet": "^8.1.0",
		"jsonwebtoken": "^9.0.2",
		"prisma": "^6.16.2",
		"zod": "^4.1.5"
	},
	"devDependencies": {
		"tsx": "^4.20.5"
	},
	"prisma": {
		"seed": "node prisma/seed.js"
	}
}
